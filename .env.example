# Copier en .env.local pour le développement. Les vraies valeurs vont dans Vercel (Settings > Environment Variables).

# Sanity : identifiant du projet et dataset (pas secrets, ils finissent dans le code du site).
NEXT_PUBLIC_SANITY_PROJECT_ID=91cstvku
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity : jeton de lecture (droit Viewer), pour les brouillons et l'aperçu. Secret.
SANITY_API_READ_TOKEN=

# Adresse publique du site, sans barre finale (métadonnées, liens absolus).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
